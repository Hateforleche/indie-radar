---
import '@fontsource-variable/anybody/standard.css';
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '../styles/global.css';
import GameCard from './GameCard.astro';
import { getData, countBy } from '../lib/data.js';
import { t as dict } from '../lib/i18n.js';

const { lang } = Astro.props;
const t = dict[lang];
const { site, sections, radarBlips } = getData(lang);

const weekCount = countBy(sections.week);
const gemsCount = countBy(sections.gems);
const tilts = [-1.2, 0.8, -0.4, 1.4, -1.6, 0.5, 1, -0.8];
const podiumOrder = [1, 0, 2];
const variants = [
  { key: 'all', list: sections.top.all },
  { key: 'steam', list: sections.top.steam },
  { key: 'itch', list: sections.top.itch },
];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const withBase = (p) => `${base}/${p}`;
const homeFor = (l) => withBase(l === 'es' ? '' : `${l}/`);
const absolute = (l) => new URL(homeFor(l), Astro.site).href;
const sourceName = (s) => (s === 'steam' ? 'Steam' : 'itch.io');
const countText = (n) => `${n} ${t.games(n)}`;
---
<!doctype html>
<html lang={lang} data-filter="all">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#E8EAE4" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={absolute(lang)} />
    <link rel="alternate" hreflang="es" href={absolute('es')} />
    <link rel="alternate" hreflang="en" href={absolute('en')} />
    <link rel="alternate" hreflang="x-default" href={absolute('es')} />
    <script is:inline define:vars={{ lang, enHome: homeFor('en') }}>
      try {
        const f = localStorage.getItem('indie-radar-filter');
        if (f === 'steam' || f === 'itch') document.documentElement.dataset.filter = f;
        // First visit to the Spanish page from a browser not set to Spanish: go to English.
        const pref = localStorage.getItem('indie-radar-lang');
        const prefersEs = (navigator.languages || [navigator.language]).some((l) => /^es\b/i.test(l));
        if (lang === 'es' && (pref === 'en' || (!pref && !prefersEs))) location.replace(enHome + location.hash);
      } catch {}
    </script>
  </head>
  <body>
    <svg class="grain" aria-hidden="true">
      <filter id="grain-f"><feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" stitchTiles="stitch" /></filter>
      <rect width="100%" height="100%" filter="url(#grain-f)" />
    </svg>

    <a class="skip" href="#week">{t.skip}</a>

    <header class="bar">
      <a class="bar__brand" href="#top" aria-label={t.backToTop}>
        <span class="bar__dot" aria-hidden="true"></span>Indie Radar
      </a>
      <nav class="bar__nav" aria-label={t.sectionsNav}>
        <a href="#week">{t.week.title}</a>
        <a href="#best">{t.top.title}</a>
        <a href="#gems">{t.gems.title}</a>
        <a href="#soon">{t.soon.title}</a>
      </nav>
      <nav class="lang" aria-label={t.langSwitch.nav} data-active={lang}>
        <span class="lang__knob" aria-hidden="true"></span>
        {(['es', 'en']).map((l) => (
          <a
            href={homeFor(l)}
            hreflang={l}
            lang={l}
            aria-current={l === lang ? 'page' : undefined}
            aria-label={dict[l].langSwitch.name}
            data-set-lang={l}
          >{l.toUpperCase()}</a>
        ))}
      </nav>
      <div class="filter" role="group" aria-label={t.filterLabel}>
        <span class="filter__ink" aria-hidden="true"></span>
        <button type="button" data-set-filter="all">{t.all}</button>
        <button type="button" data-set-filter="steam">Steam</button>
        <button type="button" data-set-filter="itch">itch.io</button>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <h1 class="hero__mark" aria-label="Indie Radar">
          <span class="riso" data-text="Indie" aria-hidden="true">Indie</span>
          <span class="riso" data-text="Radar" aria-hidden="true">Radar</span>
        </h1>

        <div class="radar" aria-hidden="true">
          <div class="radar__rings"></div>
          <div class="radar__sweep"></div>
          {radarBlips.map((b) => (
            <span
              class:list={['blip', `blip--${b.source}`]}
              style={`--a:${b.angle}deg;--r:${b.radius}%;--d:${(((b.angle + 90) % 360) / 360 * 6).toFixed(2)}s`}
            ><span class="blip__label">{b.name}</span></span>
          ))}
        </div>

        <div class="hero__intro">
          <p class="hero__lede">{t.lede}</p>
          {site.steamIndies30d && (
            <p class="hero__stat">
              <strong>{site.num.format(site.steamIndies30d)}</strong>
              <span>{t.stat}</span>
            </p>
          )}
          <p class="hero__updated">{t.updated(site.updatedLabel)}</p>
        </div>
      </section>

      <section class="section" id="week" aria-labelledby="h-week">
        <div class="section__head">
          <h2 class="section__title" id="h-week" data-reveal>{t.week.title}</h2>
          <p class="section__note">
            {t.week.note}
            <span class="count" data-one={t.games(1)} data-many={t.games(2)} data-count-all={weekCount.all} data-count-steam={weekCount.steam} data-count-itch={weekCount.itch}>{countText(weekCount.all)}</span>
          </p>
          <div class="rail-ctrl">
            <button type="button" class="rail-btn" data-rail="prev" aria-label={t.week.prev}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
            </button>
            <button type="button" class="rail-btn" data-rail="next" aria-label={t.week.next}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
            </button>
          </div>
        </div>
        <div class="rail" tabindex="0" aria-label={t.week.rail}>
          {sections.week.map((g, i) => <GameCard game={g} lang={lang} loading={i < 6 ? 'eager' : 'lazy'} />)}
        </div>
      </section>

      <section class="section section--top" id="best" aria-labelledby="h-best">
        <div class="section__head">
          <h2 class="section__title" id="h-best" data-reveal>{t.top.title}</h2>
          <p class="section__note">{t.top.note}</p>
        </div>

        {variants.map(({ key, list }) => (
          <div class="top" data-variant={key}>
            <ol class="podium" data-reveal>
              {podiumOrder.map((idx) => {
                const g = list[idx];
                if (!g) return null;
                return (
                  <li class:list={['podium__step', `podium__step--${idx + 1}`]} data-source={g.source}>
                    <a href={g.url} target="_blank" rel="noopener" class="podium__link">
                      <span class="podium__rank" aria-label={t.top.rank(idx + 1)}>{idx + 1}</span>
                      <figure class="podium__art">
                        <img src={g.image} alt="" loading="lazy" decoding="async" />
                      </figure>
                      <div class="podium__text">
                        <h3>{g.name}</h3>
                        <p class="podium__maker">{g.maker}</p>
                        {g.rating && (
                          <p class="podium__rating">
                            <strong>{g.rating.value}</strong> {g.rating.label.toLowerCase()}, {g.rating.detail}
                          </p>
                        )}
                        <p class="podium__foot">
                          {g.price && <span class="tag tag--price">{g.price.label}</span>}
                          <span class="podium__src">{sourceName(g.source)}</span>
                        </p>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ol>

            <ol class="ranks" start="4">
              {list.slice(3).map((g, i) => (
                <li class="ranks__row" data-source={g.source}>
                  <a href={g.url} target="_blank" rel="noopener">
                    <span class="ranks__n" aria-hidden="true">{i + 4}</span>
                    <img src={g.image} alt="" loading="lazy" decoding="async" />
                    <span class="ranks__name">
                      <strong>{g.name}</strong>
                      <span>{g.maker}</span>
                    </span>
                    {g.rating && (
                      <span class="ranks__bar" style={`--p:${g.rating.pct}`}>
                        <span>{g.rating.value}</span>
                      </span>
                    )}
                    <span class="ranks__src">{sourceName(g.source)}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </section>

      <section class="section section--gems" id="gems" aria-labelledby="h-gems">
        <div class="section__head">
          <h2 class="section__title" id="h-gems" data-reveal>{t.gems.title}</h2>
          <p class="section__note">
            {t.gems.note}
            <span class="count" data-one={t.games(1)} data-many={t.games(2)} data-count-all={gemsCount.all} data-count-steam={gemsCount.steam} data-count-itch={gemsCount.itch}>{countText(gemsCount.all)}</span>
          </p>
        </div>
        <div class="mosaic">
          {sections.gems.map((g, i) => <GameCard game={g} lang={lang} tilt={tilts[i % tilts.length]} />)}
        </div>
      </section>

      <section class="section section--soon" id="soon" aria-labelledby="h-soon">
        <div class="section__head">
          <h2 class="section__title" id="h-soon" data-reveal>{t.soon.title}</h2>
          <p class="section__note">{t.soon.note(sections.upcomingCount)}</p>
        </div>
        <p class="soon__itch-note">
          {t.soon.itchNote}
          <button type="button" data-set-filter="steam">{t.soon.itchButton}</button>
        </p>
        <ol class="timeline">
          {sections.upcoming.map((group) => (
            <li class="timeline__day" data-reveal>
              <div class="timeline__date">
                <strong>{group.label}</strong>
                {group.daysAway != null && <span>{t.soon.days(group.daysAway)}</span>}
              </div>
              <div class="timeline__games">
                {group.games.map((g) => <GameCard game={g} lang={lang} variant="compact" />)}
              </div>
            </li>
          ))}
        </ol>
      </section>
    </main>

    <footer class="foot">
      <div class="foot__mark" aria-hidden="true">Indie Radar</div>
      <div class="foot__cols">
        <div>
          <h2>{t.foot.pickTitle}</h2>
          <p>{t.foot.pick}</p>
        </div>
        <div>
          <h2>{t.foot.rankTitle}</h2>
          <p>{t.foot.rank}</p>
        </div>
        <div>
          <h2>{t.foot.dataTitle}</h2>
          <p>{t.foot.data(site.updatedLabel)}</p>
        </div>
      </div>
    </footer>

    <script src="../scripts/app.js"></script>
  </body>
</html>
