---
/**
 * A game "clipping". Variants:
 *  - default: image + text, used in the carousel and the gems mosaic
 *  - compact: horizontal row, used in the upcoming timeline
 */
const { game, variant = 'default', loading = 'lazy', tilt = 0 } = Astro.props;
const sourceName = game.source === 'steam' ? 'Steam' : 'itch.io';
---
<article
  class:list={['card', `card--${variant}`, `card--${game.source}`]}
  data-source={game.source}
  style={tilt ? `--tilt:${tilt}deg` : undefined}
>
  <a class="card__link" href={game.url} target="_blank" rel="noopener">
    <figure class="card__art">
      <img src={game.image} alt="" loading={loading} decoding="async"
        width={game.source === 'steam' ? 460 : 315}
        height={game.source === 'steam' ? 215 : 250} />
    </figure>
    <div class="card__body">
      <h3 class="card__title">{game.name}</h3>
      {game.maker && <p class="card__maker">{game.maker}</p>}
      {variant !== 'compact' && game.description && (
        <p class="card__desc">{game.description}</p>
      )}
      <div class="card__meta">
        {game.price && (
          <span class:list={['tag', 'tag--price', { 'tag--free': game.price.free }]}>
            {game.price.discount > 0 && <b>−{game.price.discount} %</b>}
            {game.price.label}
          </span>
        )}
        {game.rating && (
          <span class="tag tag--rating" title={`${game.rating.label}, ${game.rating.detail}`}>
            {game.rating.value}
            <small>{game.rating.detail}</small>
          </span>
        )}
        {variant === 'compact' && game.popularityRank && (
          <span class="tag">Nº {game.popularityRank} en popularidad</span>
        )}
        {variant !== 'compact' && game.dateLabel && <span class="tag tag--date">{game.dateLabel}</span>}
      </div>
      <span class="card__source">{sourceName}</span>
    </div>
  </a>
</article>
